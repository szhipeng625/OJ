<Window x:Class="client.Presentation.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACMDOG · 注册" Height="520" Width="400"
        Icon="pack://application:,,,/Assets/ACMOJ.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF5F7FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0" Background="#2D7DF6" Padding="24,18">
            <StackPanel>
                <TextBlock Text="注册账号" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Foreground="#CCE0FF" FontSize="12" Margin="0,4,0,0" Text="注册后可登录做题（仅限普通用户）"/>
            </StackPanel>
        </Border>

        <!-- 表单 -->
        <StackPanel Grid.Row="1" Margin="28,18">
            <TextBlock Text="用户名" Foreground="#444" Margin="0,0,0,4"/>
            <TextBox x:Name="UserBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>

            <TextBlock Text="密码" Foreground="#444" Margin="0,12,0,4"/>
            <PasswordBox x:Name="PassBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>

            <TextBlock Text="邮箱" Foreground="#444" Margin="0,12,0,4"/>
            <TextBox x:Name="EmailBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>

            <TextBlock Text="姓名" Foreground="#444" Margin="0,12,0,4"/>
            <TextBox x:Name="NameBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>

            <TextBlock Text="学校" Foreground="#444" Margin="0,12,0,4"/>
            <TextBox x:Name="SchoolBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>

            <TextBlock x:Name="ErrText" Foreground="#D9534F" Margin="0,10,0,0"
                       TextWrapping="Wrap" FontSize="12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Width="80" Height="34" Margin="0,0,10,0" Click="CancelBtn_OnClick"/>
                <Button x:Name="RegBtn" Content="注册" Width="100" Height="34"
                        Background="#2D7DF6" Foreground="White" FontWeight="SemiBold"
                        IsDefault="True" Click="RegBtn_OnClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
