<Window x:Class="client.Presentation.Views.SolveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:client.Presentation.Controls"
        Title="做题" Height="720" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F8FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部栏：返回 + 标题 + 上次提交结果 -->
        <Border Grid.Row="0" Background="#2D7DF6" Padding="14,9">
            <DockPanel LastChildFill="False">
                <Button Content="&#x2190; 返回" Width="92" Height="30"
                        HorizontalAlignment="Left" Click="OnBack"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="LastVerdictText" Foreground="White"
                               VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                               MaxWidth="380" TextAlignment="Right"/>
                </StackPanel>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- 主体：左题目描述，右代码页 -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#FFE3E6EB" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock x:Name="DescTitle" DockPanel.Dock="Top" FontWeight="Bold" FontSize="17"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="MetaText" DockPanel.Dock="Top" TextWrapping="Wrap"
                               Margin="0,0,0,6" Foreground="#666" FontSize="12"/>
                    <WebBrowser x:Name="DescBox"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                        <TextBlock Text="提交代码（C++）" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="g++ -O2" HorizontalAlignment="Right"
                                   Foreground="Gray" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="#FFE3E6EB" BorderThickness="0,1,0,0"
                            Padding="10,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="SubmitBtn" Content="提交判题"
                                        Style="{StaticResource ButtonPrimary}"
                                        Width="110" Height="32" Click="SubmitBtn_OnClick"/>
                                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                           Margin="12,0,0,0" Foreground="Gray"/>
                            </StackPanel>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="VerdictText" Text="结果：等待提交"
                                           FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ListBox x:Name="CaseList" Grid.Row="1" BorderThickness="0" Height="130"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Background="#1E1E1E" Margin="10,0,10,10">
                        <controls:CodeEditor x:Name="CodeBox"/>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
