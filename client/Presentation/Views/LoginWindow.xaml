<Window x:Class="client.Presentation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACMDOG · 登录" Height="360" Width="400"
        Icon="pack://application:,,,/Assets/ACMOJ.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF5F7FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0" Background="#2D7DF6" Padding="24,18">
            <StackPanel>
                <TextBlock Text="ACMDOG" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Foreground="#CCE0FF" FontSize="12" Margin="0,4,0,0" Text="请登录后开始做题"/>
            </StackPanel>
        </Border>

        <!-- 表单 -->
        <StackPanel Grid.Row="1" Margin="28,24">
            <TextBlock Text="用户名" Foreground="#444" Margin="0,0,0,4"/>
            <TextBox x:Name="UserBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                     FontSize="14"/>

            <TextBlock Text="密码" Foreground="#444" Margin="0,14,0,4"/>
            <PasswordBox x:Name="PassBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                         FontSize="14"/>

            <TextBlock x:Name="ErrText" Foreground="#D9534F" Margin="0,12,0,0"
                       TextWrapping="Wrap" FontSize="12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="注册" Width="80" Height="34" Margin="0,0,10,0"
                        Click="RegisterBtn_OnClick"/>
                <Button x:Name="LoginBtn" Content="登录" Width="100" Height="34"
                        Background="#2D7DF6" Foreground="White" FontWeight="SemiBold"
                        IsDefault="True" Click="LoginBtn_OnClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
