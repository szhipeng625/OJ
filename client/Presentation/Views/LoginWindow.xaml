<Window x:Class="client.Presentation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OJ 在线判题系统 · 登录" Height="420" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF5F7FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0" Background="#2D7DF6" Padding="24,18">
            <StackPanel>
                <TextBlock Text="OJ 在线判题系统" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="ModeText" Foreground="#CCE0FF" FontSize="12" Margin="0,4,0,0" Text="请登录后开始做题"/>
            </StackPanel>
        </Border>

        <!-- 表单 -->
        <StackPanel Grid.Row="1" Margin="28,20">
            <TextBlock Text="用户名" Foreground="#444" Margin="0,0,0,4"/>
            <TextBox x:Name="UserBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                     FontSize="14"/>

            <TextBlock Text="密码" Foreground="#444" Margin="0,14,0,4"/>
            <PasswordBox x:Name="PassBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                         FontSize="14"/>

            <TextBlock x:Name="RoleLabel" Text="注册角色" Foreground="#444" Margin="0,14,0,4"/>
            <ComboBox x:Name="RoleBox" Height="30" SelectedIndex="0">
                <ComboBoxItem Content="user（参赛者）"/>
                <ComboBoxItem Content="author（出题人）"/>
                <ComboBoxItem Content="admin（管理员）"/>
            </ComboBox>

            <TextBlock x:Name="ErrText" Foreground="#D9534F" Margin="0,12,0,0"
                       TextWrapping="Wrap" FontSize="12"/>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="HintText" Foreground="#999" FontSize="11"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="首次使用请点注册；已有账号直接登录"/>
                <Button Grid.Column="1" x:Name="RegBtn" Content="注册" Width="80" Height="32"
                        Click="RegBtn_OnClick"/>
                <Button Grid.Column="3" x:Name="LoginBtn" Content="登录" Width="80" Height="32"
                        Background="#2D7DF6" Foreground="White" FontWeight="SemiBold"
                        IsDefault="True" Click="LoginBtn_OnClick"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
