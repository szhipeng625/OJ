<Window x:Class="client.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:controls="clr-namespace:client.Presentation.Controls"
        Title="OJ 在线判题系统" Height="780" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F8FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#2D7DF6" Padding="18,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE0E6;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                               FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OJ 在线判题系统" Foreground="White" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <hc:Badge x:Name="NickBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="#FF33507A" Text="未登录" Margin="0,0,10,0"/>
                <hc:Badge x:Name="ConnBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="#FF5A6172" Text="未连接"/>
            </DockPanel>
        </Border>

        <!-- 主体：题库 / 比赛 两个 Tab -->
        <TabControl Grid.Row="1" Margin="10" BorderThickness="0">
            <!-- ================= 题库 ================= -->
            <TabItem Header="题库">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="题目列表" FontWeight="SemiBold"
                                       Margin="12,10,0,6"/>
                            <ListBox x:Name="ProblemList" BorderThickness="0" Background="Transparent"
                                     SelectionChanged="ProblemList_OnSelected"/>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.8*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="170"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="14">
                            <DockPanel>
                                <TextBlock x:Name="MetaText" DockPanel.Dock="Top" TextWrapping="Wrap"
                                           Margin="0,0,0,6" Foreground="#666" FontSize="12"/>
                                <TextBlock DockPanel.Dock="Top" Text="题目描述" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <WebBrowser x:Name="DescBox"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="2" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="14,10,14,6">
                                    <TextBlock Text="提交代码（C++）" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="g++ -O2" HorizontalAlignment="Right"
                                               Foreground="Gray" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Background="#1E1E1E" Margin="10,0,10,10">
                                    <controls:CodeEditor x:Name="CodeBox" Text="#include &lt;iostream&gt;&#x0a;using namespace std;&#x0a;int main(){&#x0a;    int a, b;&#x0a;    cin &gt;&gt; a &gt;&gt; b;&#x0a;    cout &lt;&lt; a + b &lt;&lt; endl;&#x0a;    return 0;&#x0a;}"/>
                                </Border>
                            </DockPanel>
                        </Border>

                        <DockPanel Grid.Row="4">
                            <Button x:Name="SubmitBtn" Content="提交判题" Style="{StaticResource ButtonPrimary}"
                                    Width="120" Height="36" Click="SubmitBtn_OnClick"/>
                            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="Gray"/>
                        </DockPanel>

                        <Border Grid.Row="6" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="14">
                            <DockPanel>
                                <TextBlock x:Name="VerdictText" DockPanel.Dock="Top" Text="结果：等待提交"
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ListBox x:Name="CaseList" BorderThickness="0"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= 比赛 ================= -->
            <TabItem x:Name="ContestTab" Header="比赛" IsEnabled="False">
                <Grid Margin="4">
                    <!-- ============ 视图一：比赛列表（未进入比赛前只看得到列表） ============ -->
                    <Grid x:Name="ContestListView">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <Grid DockPanel.Dock="Top" Margin="4,4,4,8">
                                <TextBlock Text="比赛列表" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Content="刷新" Width="70" Height="30" HorizontalAlignment="Right" Click="OnRefreshContests"/>
                            </Grid>
                            <ListBox x:Name="ContestList" SelectionChanged="OnSelectContest"/>
                        </DockPanel>

                        <Border Grid.Column="2" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="14">
                            <DockPanel>
                                <StackPanel x:Name="ContestDetailHead" DockPanel.Dock="Top">
                                    <TextBlock x:Name="ContestListTitle" FontSize="16" FontWeight="SemiBold"
                                               Text="请选择左侧比赛" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ContestListMeta" Foreground="#666" FontSize="12"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="比赛说明" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Bottom" Background="#FFF7F9FC" CornerRadius="6"
                                        Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="RegisterVirtualBox" Margin="0,2"
                                                  Content="虚拟参赛（比赛结束后补赛，不计正式排名）"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="RegisterBtn" Content="报名"
                                                    Style="{StaticResource ButtonPrimary}"
                                                    Width="120" Height="34" Click="OnRegisterContest"/>
                                            <Button x:Name="EnterContestBtn" Content="进入比赛"
                                                    Style="{StaticResource ButtonPrimary}"
                                                    Width="120" Height="34" Margin="10,0,0,0"
                                                    Click="OnEnterContest" Visibility="Collapsed"/>
                                            <TextBlock x:Name="RegisterHint" VerticalAlignment="Center"
                                                       Margin="12,0,0,0" Foreground="Gray" FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <WebBrowser x:Name="ContestListDesc"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ============ 视图二：比赛工作台 ============ -->
                    <Grid x:Name="ContestRoomView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 比赛导航栏：做题 / 排行榜 / 提交记录 -->
                        <Border Grid.Row="0" Background="#FFF0F4FB" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                            <DockPanel LastChildFill="False">
                                <Button Content="&#x2190; 返回比赛列表" Width="120" Height="32"
                                        HorizontalAlignment="Left" Click="OnExitContest"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            DockPanel.Dock="Right">
                                    <Button x:Name="NavSolveBtn" Content="做题" Width="90" Height="32"
                                            Margin="4,0" Click="OnNavSolve"/>
                                    <Button x:Name="NavBoardBtn" Content="排行榜" Width="90" Height="32"
                                            Margin="4,0" Click="OnNavBoard"/>
                                    <Button x:Name="NavSubsBtn" Content="提交记录" Width="90" Height="32"
                                            Margin="4,0" Click="OnNavSubmissions"/>
                                </StackPanel>
                                <TextBlock x:Name="RoomTitle" FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>

                        <!-- 做题页：左题目、右代码 -->
                        <Grid x:Name="RoomSolvePanel" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="本场题目" FontWeight="SemiBold"
                                           Margin="4,4,0,6"/>
                                <ListBox x:Name="ContestProblemList" SelectionChanged="OnSelectContestProblem"/>
                            </DockPanel>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1.6*"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="2.6*"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="140"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#FFF0F4FB" CornerRadius="6"
                                        Padding="10,8" Margin="0,0,0,6">
                                    <TextBlock x:Name="ContestInfoText" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Foreground="#333"/>
                                </Border>

                                <Border Grid.Row="1" BorderBrush="#FFE3E6EB" BorderThickness="1"
                                        CornerRadius="8" Padding="12">
                                    <DockPanel>
                                        <TextBlock x:Name="ContestMetaText" DockPanel.Dock="Top"
                                                   Margin="0,0,0,4" Foreground="#666" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock DockPanel.Dock="Top" Text="题目描述" FontWeight="SemiBold"
                                                   Margin="0,0,0,4"/>
                                        <WebBrowser x:Name="ContestDescBox"/>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Row="3" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8">
                                    <Border Background="#1E1E1E" CornerRadius="0" Margin="10">
                                        <controls:CodeEditor x:Name="ContestCodeBox"
                                                             Text="#include &lt;iostream&gt;&#x0a;using namespace std;&#x0a;int main(){&#x0a;    return 0;&#x0a;}"/>
                                    </Border>
                                </Border>

                                <DockPanel Grid.Row="5">
                                    <Button x:Name="ContestSubmitBtn" Content="提交判题"
                                            Style="{StaticResource ButtonPrimary}"
                                            Width="120" Height="34" Click="ContestSubmit_OnClick"/>
                                    <TextBlock x:Name="ContestStatusText" VerticalAlignment="Center"
                                               Margin="14,0,0,0" Foreground="Gray"/>
                                </DockPanel>

                                <Border Grid.Row="7" BorderBrush="#FFE3E6EB" BorderThickness="1"
                                        CornerRadius="8" Padding="12">
                                    <DockPanel>
                                        <TextBlock x:Name="ContestVerdictText" DockPanel.Dock="Top"
                                                   Text="结果：等待提交" FontSize="14" FontWeight="Bold"
                                                   Margin="0,0,0,6"/>
                                        <ListBox x:Name="ContestCaseList" BorderThickness="0"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 排行榜页 -->
                        <Border x:Name="RoomBoardPanel" Grid.Row="1" Visibility="Collapsed"
                                BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="10">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                               Text="排行榜（带 * 为虚拟参赛者，不占正式名次，位置按成绩排列）"/>
                                    <Button Content="刷新" Width="70" Height="30" HorizontalAlignment="Right"
                                            Click="OnRefreshBoard"/>
                                </Grid>
                                <ListView x:Name="BoardListView">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="名次" Width="80"
                                                            DisplayMemberBinding="{Binding Rank}"/>
                                            <GridViewColumn Header="用户" Width="220"
                                                            DisplayMemberBinding="{Binding Username}"/>
                                            <GridViewColumn Header="AC 数" Width="80"
                                                            DisplayMemberBinding="{Binding Solved}"/>
                                            <GridViewColumn Header="罚时(分)" Width="100"
                                                            DisplayMemberBinding="{Binding Penalty}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>

                        <!-- 提交记录页 -->
                        <Border x:Name="RoomSubsPanel" Grid.Row="1" Visibility="Collapsed"
                                BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="10">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                               Text="本场提交记录（每人每题保留最后一次提交结果，按时间倒序）"/>
                                    <Button Content="刷新" Width="70" Height="30" HorizontalAlignment="Right"
                                            Click="OnRefreshSubmissions"/>
                                </Grid>
                                <ListView x:Name="SubmissionListView">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="提交时间" Width="160"
                                                            DisplayMemberBinding="{Binding Ts}"/>
                                            <GridViewColumn Header="题号" Width="70"
                                                            DisplayMemberBinding="{Binding ProblemId}"/>
                                            <GridViewColumn Header="用户" Width="150"
                                                            DisplayMemberBinding="{Binding Username}"/>
                                            <GridViewColumn Header="结果" Width="70"
                                                            DisplayMemberBinding="{Binding Verdict}"/>
                                            <GridViewColumn Header="详情" Width="260"
                                                            DisplayMemberBinding="{Binding Detail}"/>
                                            <GridViewColumn Header="类型" Width="70"
                                                            DisplayMemberBinding="{Binding Kind}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
