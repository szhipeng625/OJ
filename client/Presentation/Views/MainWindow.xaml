<Window x:Class="client.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:controls="clr-namespace:client.Presentation.Controls"
        Title="OJ 在线判题系统" Height="780" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F8FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#2D7DF6" Padding="18,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE0E6;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                               FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OJ 在线判题系统" Foreground="White" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <hc:Badge x:Name="NickBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="#FF33507A" Text="未登录" Margin="0,0,10,0"/>
                <hc:Badge x:Name="ConnBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="#FF5A6172" Text="未连接"/>
            </DockPanel>
        </Border>

        <!-- 主体：题库 / 比赛 两个 Tab -->
        <TabControl Grid.Row="1" Margin="10" BorderThickness="0">
            <!-- ================= 题库 ================= -->
            <TabItem Header="题库">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="题目列表" FontWeight="SemiBold"
                                       Margin="12,10,0,6"/>
                            <ListBox x:Name="ProblemList" BorderThickness="0" Background="Transparent"
                                     SelectionChanged="ProblemList_OnSelected"/>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.8*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="170"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="14">
                            <DockPanel>
                                <TextBlock x:Name="MetaText" DockPanel.Dock="Top" TextWrapping="Wrap"
                                           Margin="0,0,0,6" Foreground="#666" FontSize="12"/>
                                <TextBlock DockPanel.Dock="Top" Text="题目描述" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <WebBrowser x:Name="DescBox"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="2" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="14,10,14,6">
                                    <TextBlock Text="提交代码（C++）" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="g++ -O2" HorizontalAlignment="Right"
                                               Foreground="Gray" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Background="#1E1E1E" Margin="10,0,10,10">
                                    <controls:CodeEditor x:Name="CodeBox" Text="#include &lt;iostream&gt;&#x0a;using namespace std;&#x0a;int main(){&#x0a;    int a, b;&#x0a;    cin &gt;&gt; a &gt;&gt; b;&#x0a;    cout &lt;&lt; a + b &lt;&lt; endl;&#x0a;    return 0;&#x0a;}"/>
                                </Border>
                            </DockPanel>
                        </Border>

                        <DockPanel Grid.Row="4">
                            <Button x:Name="SubmitBtn" Content="提交判题" Style="{StaticResource ButtonPrimary}"
                                    Width="120" Height="36" Click="SubmitBtn_OnClick"/>
                            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="Gray"/>
                        </DockPanel>

                        <Border Grid.Row="6" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="14">
                            <DockPanel>
                                <TextBlock x:Name="VerdictText" DockPanel.Dock="Top" Text="结果：等待提交"
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ListBox x:Name="CaseList" BorderThickness="0"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= 比赛 ================= -->
            <TabItem x:Name="ContestTab" Header="比赛" IsEnabled="False">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：比赛列表 + 题目列表 -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="比赛列表" FontWeight="SemiBold" Margin="4,4,0,4"/>
                        <ListBox x:Name="ContestList" DockPanel.Dock="Top" Height="180"
                                 SelectionChanged="OnSelectContest"/>
                        <TextBlock DockPanel.Dock="Top" Text="比赛题目" FontWeight="SemiBold" Margin="4,8,0,4"/>
                        <ListBox x:Name="ContestProblemList" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="OnSelectContestProblem"/>
                    </DockPanel>

                    <!-- 中：做题区 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.6*"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="2.6*"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="140"/>
                        </Grid.RowDefinitions>

                        <!-- 比赛信息条 -->
                        <Border Grid.Row="0" Background="#FFF0F4FB" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                            <DockPanel>
                                <CheckBox x:Name="VirtualBox" DockPanel.Dock="Right" Content="虚拟参赛"
                                          VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="比赛结束后可虚拟参赛，提交计入虚拟榜"/>
                                <Button DockPanel.Dock="Right" Content="刷新榜单" Width="90" Margin="0,0,12,0"
                                        Click="OnRefreshBoard"/>
                                <TextBlock x:Name="ContestInfoText" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Foreground="#333"/>
                            </DockPanel>
                        </Border>

                        <!-- 题目描述 -->
                        <Border Grid.Row="1" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="12">
                            <DockPanel>
                                <TextBlock x:Name="ContestMetaText" DockPanel.Dock="Top" Margin="0,0,0,4"
                                           Foreground="#666" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock DockPanel.Dock="Top" Text="题目描述" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <WebBrowser x:Name="ContestDescBox"/>
                            </DockPanel>
                        </Border>

                        <!-- 代码编辑 -->
                        <Border Grid.Row="3" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8">
                            <DockPanel>
                                <Border Background="#1E1E1E" CornerRadius="0" Margin="10">
                                    <controls:CodeEditor x:Name="ContestCodeBox" Text="#include &lt;iostream&gt;&#x0a;using namespace std;&#x0a;int main(){&#x0a;    return 0;&#x0a;}"/>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- 提交栏 -->
                        <DockPanel Grid.Row="5">
                            <Button x:Name="ContestSubmitBtn" Content="提交判题" Style="{StaticResource ButtonPrimary}"
                                    Width="120" Height="34" Click="ContestSubmit_OnClick"/>
                            <TextBlock x:Name="ContestStatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="Gray"/>
                        </DockPanel>

                        <!-- 结果 -->
                        <Border Grid.Row="7" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="12">
                            <DockPanel>
                                <TextBlock x:Name="ContestVerdictText" DockPanel.Dock="Top" Text="结果：等待提交"
                                           FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ListBox x:Name="ContestCaseList" BorderThickness="0"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 右：榜单 -->
                    <Border Grid.Column="4" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="正式榜" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ListBox x:Name="BoardListOfficial" DockPanel.Dock="Top" Height="220"
                                     BorderThickness="0"/>
                            <TextBlock DockPanel.Dock="Top" Text="虚拟榜" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <ListBox x:Name="BoardListVirtual" BorderThickness="0"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
