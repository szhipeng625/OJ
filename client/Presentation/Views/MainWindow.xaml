<Window x:Class="client.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:controls="clr-namespace:client.Presentation.Controls"
        Title="OJ 在线判题系统" Height="780" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F8FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#2D7DF6" Padding="18,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE0E6;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                               FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OJ 在线判题系统" Foreground="White" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <hc:Badge x:Name="NickBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="#FF33507A" Text="未登录" Margin="0,0,10,0"/>
                <hc:Badge x:Name="ConnBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="#FF5A6172" Text="未连接"/>
            </DockPanel>
        </Border>

        <!-- 主体：题库 / 比赛 两个 Tab -->
        <TabControl Grid.Row="1" Margin="10" BorderThickness="0">
            <!-- ================= 题库 ================= -->
            <TabItem Header="题库">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：题库列表（含搜索），始终显示 -->
                    <Border Grid.Column="0" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="8">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="#FFE3E6EB" BorderThickness="1"
                                    CornerRadius="6" Margin="0,0,0,8">
                                <Grid>
                                    <TextBox x:Name="SearchBox" Height="30" Margin="8,6"
                                             VerticalContentAlignment="Center"
                                             TextChanged="OnSearchTextChanged"/>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#999"
                                               HorizontalAlignment="Right" Margin="0,0,16,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <TextBlock DockPanel.Dock="Top" Text="题目列表" FontWeight="SemiBold" Margin="4,0,0,6"/>
                            <ListBox x:Name="ProblemList" BorderThickness="0" Background="Transparent"
                                     SelectionChanged="ProblemList_OnSelected"
                                     MouseDoubleClick="ProblemList_OnDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMark}"
                                                       Foreground="{Binding StatusBrush}" FontWeight="Bold"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StatusTip}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- 右：个人信息（默认）/ 题目描述（单击题目后）切换 -->
                    <Grid Grid.Column="2">
                        <!-- 个人信息 -->
                        <Border x:Name="ProfilePanel" BorderBrush="#FFE3E6EB" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="个人信息" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <DockPanel DockPanel.Dock="Top">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="EditNickBtn" Content="修改昵称" Width="80" Height="28"
                                                Margin="0,0,8,0" Click="OnEditNickname" Visibility="Collapsed"/>
                                        <Button x:Name="UploadAvatarBtn" Content="上传头像" Width="80" Height="28"
                                                Click="OnUploadAvatar" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="32"
                                            Background="#2D7DF6" VerticalAlignment="Center">
                                        <Border.Clip>
                                            <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32"/>
                                        </Border.Clip>
                                        <Grid>
                                            <TextBlock x:Name="AvatarFallback" Text="&#xE13D;"
                                                       FontFamily="Segoe MDL2 Assets" Foreground="White"
                                                       FontSize="32" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ProfileName" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock x:Name="ProfileRole" Foreground="#666" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <Border DockPanel.Dock="Top" Background="#FFF7F9FC" CornerRadius="6"
                                        Padding="10" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock x:Name="StatSolved" FontSize="20" FontWeight="Bold"
                                                       Foreground="#339966" HorizontalAlignment="Center"/>
                                            <TextBlock Text="已通过" Foreground="#666" FontSize="12"
                                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock x:Name="StatTotal" FontSize="20" FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="总题目" Foreground="#666" FontSize="12"
                                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock x:Name="StatRatio" FontSize="20" FontWeight="Bold"
                                                       Foreground="#2D7DF6" HorizontalAlignment="Center"/>
                                            <TextBlock Text="通过率" Foreground="#666" FontSize="12"
                                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ProgressBar x:Name="SolveProgress" DockPanel.Dock="Top" Height="8" Margin="0,14,0,0"
                                             Foreground="#2D7DF6" Background="#FFE3E6EB"/>

                                <TextBlock DockPanel.Dock="Top" Text="题目通过情况" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                <ListBox x:Name="ProfileStatusList" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMark}"
                                                           Foreground="{Binding StatusBrush}" FontWeight="Bold"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding StatusTip}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- 题目描述 -->
                        <Border x:Name="ProblemDescPanel" BorderBrush="#FFE3E6EB" BorderThickness="1"
                                CornerRadius="8" Padding="14" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Top" Content="&#x2190; 返回个人信息" Width="130" Height="30"
                                        HorizontalAlignment="Left" Click="OnBackToProfile"/>
                                <TextBlock x:Name="HomeDescTitle" DockPanel.Dock="Top" FontWeight="Bold" FontSize="16"
                                           Margin="0,10,0,6" TextWrapping="Wrap"/>
                                <TextBlock x:Name="HomeMetaText" DockPanel.Dock="Top" TextWrapping="Wrap"
                                           Margin="0,0,0,6" Foreground="#666" FontSize="12"/>
                                <WebBrowser x:Name="HomeDescBox"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= 比赛 ================= -->
            <TabItem x:Name="ContestTab" Header="比赛" IsEnabled="False">
                <Grid Margin="4">
                    <!-- ============ 视图一：比赛列表（未进入比赛前只看得到列表） ============ -->
                    <Grid x:Name="ContestListView">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <Grid DockPanel.Dock="Top" Margin="4,4,4,8">
                                <TextBlock Text="比赛列表" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Content="刷新" Width="70" Height="30" HorizontalAlignment="Right" Click="OnRefreshContests"/>
                            </Grid>
                            <ListBox x:Name="ContestList" SelectionChanged="OnSelectContest"/>
                        </DockPanel>

                        <Border Grid.Column="2" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="14">
                            <DockPanel>
                                <StackPanel x:Name="ContestDetailHead" DockPanel.Dock="Top">
                                    <TextBlock x:Name="ContestListTitle" FontSize="16" FontWeight="SemiBold"
                                               Text="请选择左侧比赛" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ContestListMeta" Foreground="#666" FontSize="12"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="CountdownText" Foreground="#2D7DF6" FontSize="13"
                                               FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="比赛说明" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Bottom" Background="#FFF7F9FC" CornerRadius="6"
                                        Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="RegisterVirtualBox" Margin="0,2"
                                                  Content="虚拟参赛（比赛结束后补赛，不计正式排名）"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="RegisterBtn" Content="报名"
                                                    Style="{StaticResource ButtonPrimary}"
                                                    Width="120" Height="34" Click="OnRegisterContest"/>
                                            <Button x:Name="EnterContestBtn" Content="进入比赛"
                                                    Style="{StaticResource ButtonPrimary}"
                                                    Width="120" Height="34" Margin="10,0,0,0"
                                                    Click="OnEnterContest" Visibility="Collapsed"/>
                                            <TextBlock x:Name="RegisterHint" VerticalAlignment="Center"
                                                       Margin="12,0,0,0" Foreground="Gray" FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <WebBrowser x:Name="ContestListDesc"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ============ 视图二：比赛工作台 ============ -->
                    <Grid x:Name="ContestRoomView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 比赛导航栏：做题 / 排行榜 / 提交记录 -->
                        <Border Grid.Row="0" Background="#FFF0F4FB" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                            <DockPanel LastChildFill="False">
                                <Button Content="&#x2190; 返回比赛列表" Width="120" Height="32"
                                        HorizontalAlignment="Left" Click="OnExitContest"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            DockPanel.Dock="Right">
                                    <Button x:Name="NavSolveBtn" Content="比赛首页" Width="90" Height="32"
                                            Margin="4,0" Click="OnNavSolve"/>
                                    <Button x:Name="NavBoardBtn" Content="排行榜" Width="90" Height="32"
                                            Margin="4,0" Click="OnNavBoard"/>
                                    <Button x:Name="NavSubsBtn" Content="提交记录" Width="90" Height="32"
                                            Margin="4,0" Click="OnNavSubmissions"/>
                                </StackPanel>
                                <TextBlock x:Name="RoomTitle" FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>

                        <!-- 做题页：左题目列表，右比赛信息/题目描述 -->
                        <Grid x:Name="RoomSolvePanel" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左：本场题目列表，始终显示 -->
                            <Border Grid.Column="0" BorderBrush="#FFE3E6EB" BorderThickness="1"
                                    CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="本场题目" FontWeight="SemiBold"
                                               Margin="4,2,0,6"/>
                                    <ListBox x:Name="ContestProblemList"
                                             SelectionChanged="OnSelectContestProblem"
                                             MouseDoubleClick="ContestProblemList_OnDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMark}"
                                                               Foreground="{Binding StatusBrush}" FontWeight="Bold"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding StatusTip}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- 右：比赛信息（默认）/ 题目描述（单击后）切换 -->
                            <Grid Grid.Column="2">
                                <!-- 比赛信息 -->
                                <Border x:Name="ContestInfoPanel" BorderBrush="#FFE3E6EB" BorderThickness="1"
                                        CornerRadius="8" Padding="16">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="比赛信息" FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>
                                        <Border DockPanel.Dock="Top" Background="#FFF0F4FB" CornerRadius="6"
                                                Padding="12,10">
                                            <TextBlock x:Name="ContestInfoText" VerticalAlignment="Center"
                                                       TextWrapping="Wrap" Foreground="#333"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Top" Margin="0,12,0,0" TextWrapping="Wrap"
                                                   Foreground="#666" FontSize="13"
                                                   Text="· 单击题目查看题面&#x0a;· 双击题目进入做题页（左题面、右代码）&#x0a;· 返回时做题窗口关闭并释放内存，再次进入自动载入该题已保存代码"/>
                                    </DockPanel>
                                </Border>

                                <!-- 比赛题目描述 -->
                                <Border x:Name="ContestProblemDescPanel" BorderBrush="#FFE3E6EB" BorderThickness="1"
                                        CornerRadius="8" Padding="14" Visibility="Collapsed">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Top" Content="&#x2190; 返回比赛信息" Width="130" Height="30"
                                                HorizontalAlignment="Left" Click="OnBackToContestInfo"/>
                                        <TextBlock x:Name="ContestDescTitle" DockPanel.Dock="Top" FontWeight="Bold" FontSize="16"
                                                   Margin="0,10,0,6" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ContestMetaText" DockPanel.Dock="Top" TextWrapping="Wrap"
                                                   Margin="0,0,0,6" Foreground="#666" FontSize="12"/>
                                        <WebBrowser x:Name="ContestDescBox"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 排行榜页 -->
                        <Border x:Name="RoomBoardPanel" Grid.Row="1" Visibility="Collapsed"
                                BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="10">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                               Text="排行榜（带 * 为虚拟参赛者，不占正式名次，位置按成绩排列）"/>
                                    <Button Content="刷新" Width="70" Height="30" HorizontalAlignment="Right"
                                            Click="OnRefreshBoard"/>
                                </Grid>
                                <ListView x:Name="BoardListView">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="名次" Width="80"
                                                            DisplayMemberBinding="{Binding Rank}"/>
                                            <GridViewColumn Header="用户" Width="220"
                                                            DisplayMemberBinding="{Binding Username}"/>
                                            <GridViewColumn Header="AC 数" Width="80"
                                                            DisplayMemberBinding="{Binding Solved}"/>
                                            <GridViewColumn Header="罚时(分)" Width="100"
                                                            DisplayMemberBinding="{Binding Penalty}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>

                        <!-- 提交记录页 -->
                        <Border x:Name="RoomSubsPanel" Grid.Row="1" Visibility="Collapsed"
                                BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="10">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock x:Name="SubsHeaderText" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Text="本场提交记录（每人每题保留最后一次提交结果，按时间倒序）"/>
                                    <Button Content="刷新" Width="70" Height="30" HorizontalAlignment="Right"
                                            Click="OnRefreshSubmissions"/>
                                </Grid>
                                <ListView x:Name="SubmissionListView">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="提交时间" Width="160"
                                                            DisplayMemberBinding="{Binding Ts}"/>
                                            <GridViewColumn Header="题号" Width="70"
                                                            DisplayMemberBinding="{Binding ProblemId}"/>
                                            <GridViewColumn Header="用户" Width="150"
                                                            DisplayMemberBinding="{Binding Username}"/>
                                            <GridViewColumn Header="结果" Width="70"
                                                            DisplayMemberBinding="{Binding Verdict}"/>
                                            <GridViewColumn Header="详情" Width="260"
                                                            DisplayMemberBinding="{Binding Detail}"/>
                                            <GridViewColumn Header="类型" Width="70"
                                                            DisplayMemberBinding="{Binding Kind}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
