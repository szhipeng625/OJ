<Window x:Class="client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="OJ 在线判题系统" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F8FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#2D7DF6" Padding="18,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE0E6;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                               FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OJ 在线判题系统" Foreground="White" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <hc:Badge x:Name="ConnBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="#FF5A6172" Text="未连接"/>
            </DockPanel>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：题目列表 -->
            <Border Grid.Column="0" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="题目列表" FontWeight="SemiBold"
                               Margin="12,10,0,6"/>
                    <ListBox x:Name="ProblemList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="ProblemList_OnSelected"/>
                </DockPanel>
            </Border>

            <!-- 右侧：描述 / 代码 / 提交 / 结果 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.8*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="190"/>
                </Grid.RowDefinitions>

                <!-- 题目描述 -->
                <Border Grid.Row="0" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="题目描述" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="DescBox" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
                    </DockPanel>
                </Border>

                <!-- 代码编辑（深色） -->
                <Border Grid.Row="2" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="14,10,14,6">
                            <TextBlock Text="提交代码（C++）" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LangTag" Text="g++ -O2" HorizontalAlignment="Right"
                                       Foreground="Gray" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Background="#1E1E1E" CornerRadius="0" Margin="10,0,10,10">
                            <TextBox x:Name="CodeBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                     Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="14" Padding="12"
                                     Text="#include &lt;iostream&gt;&#x0a;using namespace std;&#x0a;int main(){&#x0a;    int a, b;&#x0a;    cin &gt;&gt; a &gt;&gt; b;&#x0a;    cout &lt;&lt; a + b &lt;&lt; endl;&#x0a;    return 0;&#x0a;}"/>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 提交栏 -->
                <DockPanel Grid.Row="4">
                    <Button x:Name="SubmitBtn" Content="提交判题" Style="{StaticResource ButtonPrimary}"
                            Width="120" Height="36" Click="SubmitBtn_OnClick"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="Gray"/>
                </DockPanel>

                <!-- 结果面板 -->
                <Border Grid.Row="6" BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="8" Padding="14">
                    <DockPanel>
                        <TextBlock x:Name="VerdictText" DockPanel.Dock="Top" Text="结果：等待提交"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ListBox x:Name="CaseList" BorderThickness="0"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
