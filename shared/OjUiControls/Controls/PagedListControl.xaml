<UserControl x:Class="OjUiControls.Controls.PagedListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <DockPanel>
        <!-- 标题（HeaderText 为空时隐藏） -->
        <TextBlock x:Name="HeaderBlock" DockPanel.Dock="Top" FontWeight="SemiBold"
                   Margin="4,0,0,6" Visibility="Collapsed"/>

        <!-- 分页栏 -->
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TotalText" VerticalAlignment="Center" Foreground="#888"
                               FontSize="12" Margin="0,0,12,0"/>
                    <TextBlock Text="每页" VerticalAlignment="Center" Foreground="#888" FontSize="12"/>
                    <ComboBox x:Name="PageSizeBox" Width="68" Height="26" Margin="6,0,0,0"
                              VerticalContentAlignment="Center" SelectionChanged="OnPageSizeChanged"/>
                </StackPanel>
                <!-- AutoHiding 关闭：即使只有一页也显示页码栏，避免看起来「没有分页」 -->
                <hc:Pagination x:Name="Pager" IsJumpEnabled="True" AutoHiding="False"
                               MaxPageInterval="3" HorizontalAlignment="Left"
                               PageUpdated="OnPageUpdated"/>
            </DockPanel>
        </Border>

        <!-- 列表（ItemTemplate 由宿主注入） -->
        <ListBox x:Name="InnerList" BorderThickness="0" Background="Transparent"
                 SelectionChanged="OnInnerSelectionChanged"
                 MouseDoubleClick="OnInnerDoubleClick"/>
    </DockPanel>
</UserControl>
