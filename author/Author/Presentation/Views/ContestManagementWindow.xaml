<Window x:Class="author.Presentation.Views.ContestManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="比赛管理" Height="640" Width="980"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 新建比赛 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="已有比赛（双击可再次编辑）：" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="新建比赛" Width="96" Height="32" Click="OnNewContest"/>
                <Button Content="刷新" Width="70" Height="32" Margin="8,0,0,0" Click="OnRefresh"/>
            </StackPanel>
        </DockPanel>

        <!-- 中部：比赛列表 -->
        <ListBox x:Name="ContestList" Grid.Row="1" BorderThickness="1" BorderBrush="#FFE3E6EB"
                 MouseDoubleClick="OnContestDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}" Margin="4"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部：状态 -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#2d8cf0" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</Window>
