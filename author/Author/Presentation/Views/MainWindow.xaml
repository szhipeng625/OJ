<Window x:Class="author.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OJ 出题工作台 · 启动器" Height="660" Width="900"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <DockPanel Margin="12">
        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#F5F7FA" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="就绪" TextWrapping="Wrap"/>
                <TextBlock x:Name="TaskBadge" Text="" Foreground="#D48806" Margin="18,0,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题 + 比赛管理入口 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="出题工作台（服务端）" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="比赛管理" Width="110" Height="32" Click="OnOpenContestManagement"/>
            </DockPanel>
            <TextBlock Grid.Row="1" x:Name="RootText" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- 新建题目：输入标题，自动生成编号 -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="题目标题：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="NewTitleBox" Grid.Column="1" VerticalContentAlignment="Center"
                         ToolTip="输入新题目标题，系统将自动生成题目编号"/>
                <Button Grid.Column="2" Content="新建题目" Width="96" Margin="6,0,6,0" Click="OnNewProblem"/>
                <Button Grid.Column="3" Content="打开工作台" Width="96" Click="OnOpenWorkspace"/>
            </Grid>

            <!-- 测试数据目录（自动搜索填充源） -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="测试数据目录：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="DataDirBox" Grid.Column="1" VerticalContentAlignment="Center"
                         ToolTip="新建题目时自动在此目录搜索 .in/.out 并填充到题目；也可在题目工作台的「测试数据」页点击「自动搜索填充」"/>
                <Button Grid.Column="2" Content="浏览…" Width="72" Margin="6,0,0,0" Click="OnBrowseDataDir"/>
            </Grid>

            <!-- 题库列表 -->
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="题库（双击题目可在独立窗口打开；不同题目可同时打开多个窗口并行编译/评测）："
                           Foreground="#2d8cf0" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <ListBox x:Name="ProblemList" Grid.Row="1" MouseDoubleClick="OnOpenWorkspace">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="P"/><Run Text="{Binding Id, Mode=OneWay}"/>
                                    <Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}"/>
                                    <Run Text="{Binding VisibilityText, Mode=OneWay}" Foreground="#D9534F"/>
                                </TextBlock>
                                <TextBlock Foreground="#888" FontSize="11" Text="{Binding DataText, Mode=OneWay}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
