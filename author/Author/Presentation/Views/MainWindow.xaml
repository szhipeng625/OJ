<Window x:Class="author.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACMDOG 出题工作台 · 启动器" Height="660" Width="900"
        Icon="pack://application:,,,/Assets/ACMOJ.png"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <DockPanel Margin="12">
        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#F5F7FA" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="就绪" TextWrapping="Wrap"/>
                <TextBlock x:Name="TaskBadge" Text="" Foreground="#D48806" Margin="18,0,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题 + 比赛管理入口 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border.Clip>
                            <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/>
                        </Border.Clip>
                        <Image Source="pack://application:,,,/Assets/ACMOJ.png" Stretch="UniformToFill"
                               Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="ACMDOG 出题工作台（服务端）" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="比赛管理" Width="110" Height="32" Click="OnOpenContestManagement"/>
            </DockPanel>
            <TextBlock Grid.Row="1" x:Name="RootText" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- 新建题目：点击弹出输入标题与标签，编号自动生成 -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="点击「新建题目」输入标题与标签（编号自动生成）：" Foreground="#888" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="新建题目" Width="110" Click="OnNewProblem"/>
            </Grid>

            <!-- 题库列表 -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="题库（双击题目可在独立窗口打开；不同题目可同时打开多个窗口并行编译/评测）："
                           Foreground="#2d8cf0" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <ListBox x:Name="ProblemList" Grid.Row="1" MouseDoubleClick="OnOpenWorkspace">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="P"/><Run Text="{Binding Id, Mode=OneWay}"/>
                                    <Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}"/>
                                    <Run Text="{Binding VisibilityText, Mode=OneWay}" Foreground="#D9534F"/>
                                </TextBlock>
                                <TextBlock Foreground="#888" FontSize="11" Text="{Binding DataText, Mode=OneWay}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
