<Window x:Class="author.Presentation.Views.ProblemWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:author.Presentation.Controls"
        Title="题目工作台" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Grid>
        <TabControl x:Name="Tabs" Margin="8">
            <!-- 题面 -->
            <TabItem Header="题面">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="标题：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TitleBox" Grid.Column="1"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时间限制(ms)：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TimeLimitBox" Grid.Column="1" Text="1000" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="内存限制(MB)：" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <TextBox x:Name="MemLimitBox" Grid.Column="3" Text="256" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="标签(逗号分隔)：" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <TextBox x:Name="TagsBox" Grid.Column="5" VerticalContentAlignment="Center" ToolTip="如：基础,模拟,字符串"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="题目描述（支持 Markdown 格式，Tab 缩进，客户端将按 Markdown 渲染）：" Margin="0,4"/>
                    <controls:CodeEditor x:Name="DescBox" Grid.Row="3" IsLight="True" ShowLineNumbers="False" WordWrap="True"/>
                    <Grid Grid.Row="4" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                                <Button DockPanel.Dock="Right" Content="导入…" Width="64" Height="24" Padding="0" Click="OnImportSampleIn"/>
                                <TextBlock Text="样例输入 sample.in" Foreground="#888" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="SampleInBox" AcceptsReturn="True" Height="80" FontFamily="Consolas"
                                     IsReadOnly="True" Background="#FFF7F9FC" VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                                <Button DockPanel.Dock="Right" Content="导入…" Width="64" Height="24" Padding="0" Click="OnImportSampleOut"/>
                                <TextBlock Text="样例输出 sample.out" Foreground="#888" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="SampleOutBox" AcceptsReturn="True" Height="80" FontFamily="Consolas"
                                     IsReadOnly="True" Background="#FFF7F9FC" VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Grid>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="保存题面" Width="110" Click="OnSaveStatement"/>
                        <TextBlock x:Name="StatementMsg" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 生成标准答案：标准程序 + 测试数据（生成器 .in ⇄ 标程 .out 放在一起） -->
            <TabItem Header="生成标准答案">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：标准程序 std.cpp -->
                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="标准程序 std.cpp" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="保存并编译标程" Width="130" Click="OnCompileStd"/>
                        </DockPanel>
                        <TextBlock x:Name="StdMsg" DockPanel.Dock="Bottom" Foreground="#888" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <controls:CodeEditor x:Name="StdBox"/>
                    </DockPanel>

                    <!-- 右：测试数据（生成器生成 .in 一列，标程生成 .out 一列，按生成器组别一一对应） -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="测试数据（左列输入 .in，右列输出 .out，按生成器组别一一对应）："
                                   Margin="0,0,0,4" Foreground="#888" TextWrapping="Wrap"/>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="生成标准答案" Click="OnGenerateAnswers" Width="130" Margin="0,0,6,0"
                                    ToolTip="后台自动搜索填充 .in/.out → 编译标程 → 运行标程把输出重定向到对应 .out"/>
                            <Button Content="自动搜索填充" Click="OnAutoFill" Width="120" Margin="0,0,6,0"
                                    ToolTip="从测试数据目录自动搜索 .in/.out 并填充到本题"/>
                            <Button Content="导入 .in" Click="OnImportIn" Width="80" Margin="0,0,6,0"/>
                            <Button Content="导入 .out" Click="OnImportOut" Width="80" Margin="0,0,6,0"/>
                            <Button Content="删除选中" Click="OnDeleteData" Width="90"/>
                        </WrapPanel>
                        <TextBlock x:Name="DataMsg" DockPanel.Dock="Bottom" Foreground="#2d8cf0" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <ListView x:Name="DataGroupView" BorderThickness="1" BorderBrush="#FFE3E6EB"
                                  MouseDoubleClick="OnDataRowDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="输入数据 (.in)" Width="190" DisplayMemberBinding="{Binding InDisplay}"/>
                                    <GridViewColumn Header="输出数据 (.out)" Width="190" DisplayMemberBinding="{Binding OutDisplay}"/>
                                </GridView>
                            </ListView.View>
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock FontWeight="Bold" Margin="0,6,0,2" Foreground="#2d8cf0" Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                        </ListView>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- 数据生成器 -->
            <TabItem Header="数据生成器" x:Name="GenTab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 跨题查找 -->
                    <Border Grid.Row="0" Background="#F5F7FA" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="跨题查找 gen.cpp：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="GenSearchBox" Grid.Column="1" VerticalContentAlignment="Center"
                                     ToolTip="在所有题目的 gen.cpp 中搜索函数名 / 变量 / 注释关键字" KeyDown="OnGenSearchKey"/>
                            <Button Grid.Column="2" Content="查找" Width="80" Margin="8,0,0,0" Click="OnGenSearch"/>
                        </Grid>
                    </Border>

                    <!-- 主工作区：左=生成器库（勾选），右=本题使用 + 代码编辑 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：数据生成器库 -->
                        <DockPanel Grid.Column="0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBlock Text="数据生成器（勾选=本题使用）" Foreground="#888" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="刷新" Width="58" Click="OnRefreshGenerators"/>
                                    <Button Content="新建生成器" Width="96" Margin="6,0,0,0" Click="OnNewGenerator"/>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="GenList" MouseDoubleClick="OnGenListDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsUsed, Mode=TwoWay}" Content="{Binding Display}"
                                                  VerticalAlignment="Center" Margin="2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- 右：本题使用的生成器 + 代码编辑 -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 右顶：本题使用 + 生成数据 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock x:Name="GenUsedTitle" Text="本题使用的数据生成器" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="组数" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="GenCountBox" Width="48" VerticalContentAlignment="Center"
                                             Text="10" Margin="0,0,6,0"
                                             ToolTip="每个生成器生成的数据组数 n（生成器 argv[3]）"/>
                                    <Button Content="生成数据" Width="110" Click="OnGenRun"
                                            ToolTip="对勾选的全部生成器运行，弹出窗口展示各生成器的生成情况"/>
                                </StackPanel>
                            </DockPanel>

                            <ListBox x:Name="UsedGenList" Grid.Row="1" Height="150" Margin="0,0,0,6"
                                     DisplayMemberPath="Display"/>

                            <TextBox Grid.Row="2" x:Name="GenMsg" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="#2d8cf0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Height="40" Margin="0,0,0,6"/>

                            <!-- 代码编辑区（双击生成器或新建后出现） -->
                            <Grid Grid.Row="3" x:Name="GenEditPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock x:Name="GenPathText" Foreground="#888" TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="保存代码" Width="90" Click="OnGenSave"/>
                                        <Button Content="编译" Width="70" Margin="6,0,0,0" Click="OnGenCompile"/>
                                        <Button Content="关闭编辑器" Width="96" Margin="6,0,0,0" Click="OnCloseGenEdit"/>
                                    </StackPanel>
                                </DockPanel>
                                <controls:CodeEditor x:Name="GenBox" Grid.Row="1"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="描述：" VerticalAlignment="Center"/>
                                    <TextBox x:Name="GenDescBox" Width="280" VerticalContentAlignment="Center"/>
                                    <Button Content="保存描述" Width="80" Margin="6,0,0,0" Click="OnGenSaveDesc"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>


            <!-- 发布 -->
            <TabItem Header="发布">
                <StackPanel Margin="8">
                    <TextBlock Text="发布 = 把本题完整目录复制到客户端题目目录（客户端从此目录读取题目）：" Margin="0,0,0,4" Foreground="#888"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="目标目录：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TargetBox" Grid.Column="1" Text="server\problems"
                                 IsReadOnly="True" Background="#F5F7FA" ToolTip="发布目标目录固定为客户端题目目录，不可修改"/>
                    </Grid>
                    <CheckBox x:Name="PublicBox" Margin="0,0,0,8" IsChecked="True"
                              Content="公开（客户端可见）；取消勾选则为未公开，仅服务端可见"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="校验题目完整性" Width="130" Click="OnValidate"/>
                        <Button Content="发布到客户端" Width="130" Margin="8,0,0,0" Click="OnPublish"/>
                    </StackPanel>
                    <TextBlock x:Name="PublishMsg" Foreground="#2d8cf0" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 后台任务遮罩（编译/评测/发布期间禁用编辑区） -->
        <Border x:Name="BusyMask" Background="#80000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="240" Height="6"/>
                <TextBlock x:Name="BusyText" Text="处理中…" Foreground="White" Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
