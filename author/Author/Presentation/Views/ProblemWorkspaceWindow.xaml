<Window x:Class="author.Presentation.Views.ProblemWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:author.Presentation.Controls"
        Title="题目工作台" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Grid>
        <TabControl x:Name="Tabs" Margin="8">
            <!-- 题面 -->
            <TabItem Header="题面">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="标题：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TitleBox" Grid.Column="1"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时间限制(ms)：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TimeLimitBox" Grid.Column="1" Text="1000" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="内存限制(MB)：" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <TextBox x:Name="MemLimitBox" Grid.Column="3" Text="256" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="标签(逗号分隔)：" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <TextBox x:Name="TagsBox" Grid.Column="5" VerticalContentAlignment="Center" ToolTip="如：基础,模拟,字符串"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="题目描述（支持多行，样例说明写在这里）：" Margin="0,4"/>
                    <TextBox x:Name="DescBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                    <Grid Grid.Row="4" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="样例输入 sample.in" Margin="0,0,0,2" Foreground="#888"/>
                            <TextBox x:Name="SampleInBox" AcceptsReturn="True" Height="80" FontFamily="Consolas"/>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="样例输出 sample.out" Margin="0,0,0,2" Foreground="#888"/>
                            <TextBox x:Name="SampleOutBox" AcceptsReturn="True" Height="80" FontFamily="Consolas"/>
                        </DockPanel>
                    </Grid>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="保存题面" Width="110" Click="OnSaveStatement"/>
                        <TextBlock x:Name="StatementMsg" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 测试数据 -->
            <TabItem Header="测试数据">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="导入 .in 文件" Click="OnImportIn" Width="110" Margin="0,0,6,0"/>
                        <Button Content="导入 .out 文件" Click="OnImportOut" Width="110" Margin="0,0,6,0"/>
                        <Button Content="运行标程生成答案" Click="OnGenOutputs" Width="150" Margin="0,0,6,0" ToolTip="用已编译的 std.exe 对所有 *.in 生成 *.out"/>
                        <Button Content="删除选中" Click="OnDeleteData" Width="90"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="测试数据配对（.in ⇄ .out）：" Margin="0,0,0,4" Foreground="#888"/>
                    <ListBox x:Name="DataList" DockPanel.Dock="Top" Height="260"/>
                    <TextBlock x:Name="DataMsg" DockPanel.Dock="Bottom" Foreground="#2d8cf0" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </DockPanel>
            </TabItem>

            <!-- 标程 -->
            <TabItem Header="标程 (std.cpp)">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="保存并编译标程" Width="130" Click="OnCompileStd"/>
                        <TextBlock x:Name="StdMsg" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:CodeEditor x:Name="StdBox"/>
                </DockPanel>
            </TabItem>

            <!-- 特判 -->
            <TabItem Header="特判 (spj.cpp)">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="保存并编译 spj" Width="130" Click="OnCompileSpj"/>
                        <TextBlock x:Name="SpjMsg" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:CodeEditor x:Name="SpjBox"/>
                </DockPanel>
            </TabItem>

            <!-- 数据生成 -->
            <TabItem Header="数据生成" x:Name="GenTab">
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Background="#F5F7FA" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="查找生成器代码：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="GenSearchBox" Grid.Column="1" VerticalContentAlignment="Center"
                                     ToolTip="在所有题目的 gen.cpp 中搜索函数名 / 变量 / 注释关键字" KeyDown="OnGenSearchKey"/>
                            <Button Grid.Column="2" Content="查找" Width="80" Margin="8,0,0,0" Click="OnGenSearch"/>
                        </Grid>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="保存代码（留版本）" Width="140" Click="OnGenSave"/>
                        <Button Content="导入文件" Width="90" Margin="6,0,0,0" Click="OnGenImportFile" ToolTip="导入 .cpp 文件作为生成器代码"/>
                        <Button Content="编译生成器" Width="100" Margin="6,0,0,0" Click="OnGenCompile"/>
                        <Button Content="生成数据" Width="90" Margin="6,0,0,0" Click="OnGenRun" ToolTip="编译并运行 gen.exe，stdout 重定向为编号.in"/>
                        <Button Content="导入选中.in到题目" Width="130" Margin="12,0,0,0" Click="OnGenImportToProblem" ToolTip="把选中的输入文件复制到本题测试数据目录，便于用标程生成 .out"/>
                        <Button Content="打开输出目录" Width="110" Margin="6,0,0,0" Click="OnOpenGenDir"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="GenPathText" Foreground="#888" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="GenMsg" Foreground="#2d8cf0" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="440"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="生成器代码（自动生成测试数据，stdout 即测试输入）" Foreground="#888" Margin="0,0,0,4"/>
                            <controls:CodeEditor x:Name="GenBox"/>
                        </DockPanel>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="代码版本（每次保存自动留档，仅本地）" Foreground="#888" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="恢复此版本" Width="90" Click="OnGenRestore"/>
                                </Grid>
                                <ListBox x:Name="GenVersionList" DockPanel.Dock="Top" Height="150" SelectionChanged="OnSelectGenVersion"/>
                                <controls:CodeEditor x:Name="GenVersionView" IsReadOnly="True"/>
                            </DockPanel>
                            <DockPanel Grid.Row="2">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GenFileTitle" Text="生成的数据文件" Foreground="#888" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Content="刷新" Width="60" Click="OnRefreshGenFiles"/>
                                </Grid>
                                <ListBox x:Name="GenFileList" DockPanel.Dock="Top" Height="150" SelectionChanged="OnSelectGenFile"/>
                                <controls:CodeEditor x:Name="GenFileView" IsReadOnly="True"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- 发布 -->
            <TabItem Header="发布">
                <StackPanel Margin="8">
                    <TextBlock Text="发布 = 把本题完整目录复制到客户端题目目录（客户端从此目录读取题目）：" Margin="0,0,0,4" Foreground="#888"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="目标目录：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TargetBox" Grid.Column="1" Text="D:\OJ\server\problems"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="校验题目完整性" Width="130" Click="OnValidate"/>
                        <Button Content="发布到客户端" Width="130" Margin="8,0,0,0" Click="OnPublish"/>
                    </StackPanel>
                    <TextBlock x:Name="PublishMsg" Foreground="#2d8cf0" TextWrapping="Wrap"/>

                    <TextBlock Text="历史版本（每次发布自动快照，点击版本查看题面）：" Margin="0,12,0,4" Foreground="#888"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="HistoryList" Height="150" SelectionChanged="OnSelectHistory"/>
                        <TextBox x:Name="HistoryDetail" Grid.Column="2" Height="150" IsReadOnly="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                 Foreground="#333"/>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 后台任务遮罩（编译/评测/发布期间禁用编辑区） -->
        <Border x:Name="BusyMask" Background="#80000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="240" Height="6"/>
                <TextBlock x:Name="BusyText" Text="处理中…" Foreground="White" Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
