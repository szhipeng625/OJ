<Window x:Class="author.Presentation.Views.ContestEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="比赛" Height="600" Width="840"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：编号（自动生成）+ 名称 + 时间（日历选择） -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="IdText" Foreground="#888" Margin="0,0,0,6"/>
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                    <TextBlock Text="名称：" VerticalAlignment="Center"/>
                    <TextBox x:Name="ContestNameBox" Width="280" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                    <TextBlock Text="开始：" VerticalAlignment="Center"/>
                    <DatePicker x:Name="ContestStartDate" Width="130" VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="ContestStartTime" Width="72" Margin="4,0,0,0" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                    <TextBlock Text="结束：" VerticalAlignment="Center"/>
                    <DatePicker x:Name="ContestEndDate" Width="130" VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="ContestEndTime" Width="72" Margin="4,0,0,0" VerticalContentAlignment="Center"/>
                </StackPanel>
            </WrapPanel>
        </StackPanel>

        <!-- 中部：题目勾选列表 -->
        <DockPanel Grid.Row="1">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="勾选本场比赛题目：" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="全选" Width="56" Margin="4,0,0,0" Click="OnCheckAll"/>
                    <Button Content="清空" Width="56" Margin="4,0,0,0" Click="OnCheckNone"/>
                </StackPanel>
            </DockPanel>
            <ListBox x:Name="ProblemCheckList" BorderThickness="1" BorderBrush="#FFE3E6EB">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="P"/><Run Text="{Binding Id, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Title, Mode=OneWay}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 底部：操作 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="保存并发布" Width="120" Click="OnSave"/>
            <Button Content="取消" Width="80" Margin="8,0,0,0" Click="OnCancel"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="#2d8cf0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
