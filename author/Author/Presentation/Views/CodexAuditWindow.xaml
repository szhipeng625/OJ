<Window x:Class="author.Presentation.Views.CodexAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACMDOGCodex · 审计与用量" Height="700" Width="1300"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F8FA" FontSize="13">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock Text="AI 改题审计与用量" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="ScopeText" Foreground="#666" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="刷新" Width="80" Height="28" Click="OnRefresh"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：运行记录 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#FFE3E6EB" BorderThickness="1"
                    CornerRadius="8" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="运行记录（每次指令一行）" FontWeight="SemiBold"
                               Margin="4,0,0,6"/>
                    <ListBox x:Name="RunsList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="OnSelectRun">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding Instruction}" TextTrimming="CharacterEllipsis"
                                               Foreground="#444" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="#777" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：题面改动明细（前 → 后） -->
            <Border Grid.Column="2" Background="White" BorderBrush="#FFE3E6EB" BorderThickness="1"
                    CornerRadius="8" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="题面改动明细（改前 → 改后）" FontWeight="SemiBold"
                               Margin="4,0,0,6"/>
                    <ListBox x:Name="AuditsList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFE3E6EB" BorderThickness="1" CornerRadius="6"
                                        Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Message}" Foreground="#777" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="改前" FontWeight="SemiBold" Foreground="#D9534F"/>
                                                <TextBlock Text="{Binding BeforeText}" TextWrapping="Wrap"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Background="#FFF7F8FA" Padding="6" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="改后" FontWeight="SemiBold" Foreground="#339966"/>
                                                <TextBlock Text="{Binding AfterText}" TextWrapping="Wrap"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Background="#FFF7F8FA" Padding="6" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFF7F9FC" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Text="就绪" Foreground="#666" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
