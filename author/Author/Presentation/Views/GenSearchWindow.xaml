<Window x:Class="author.Presentation.Views.GenSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查找生成器代码" Height="500" Width="760"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="打开该生成器" Width="110" IsDefault="True" Click="OnGo"/>
            <Button Content="关闭" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <ListBox x:Name="HitList" MouseDoubleClick="OnGo">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <TextBlock FontWeight="Bold">
                            <Run Text="{Binding Name, Mode=OneWay}"/>
                            <Run Text="  · 第 "/><Run Text="{Binding LineNo, Mode=OneWay}"/><Run Text=" 行"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#555"
                                   Text="{Binding Line, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
