<Window x:Class="author.Presentation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACMDOG 出题端 · 登录" Height="320" Width="400"
        Icon="pack://application:,,,/Assets/ACMOJ.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF5F7FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#3D5AFE" Padding="24,18">
            <StackPanel>
                <TextBlock Text="ACMDOG 出题工作台" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Foreground="#D0DCFF" FontSize="12" Margin="0,4,0,0"
                           Text="仅 admin / author 角色可登录"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="28,22">
            <TextBlock Text="用户名" Foreground="#444" Margin="0,0,0,4"/>
            <TextBox x:Name="UserBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>

            <TextBlock Text="密码" Foreground="#444" Margin="0,14,0,4"/>
            <PasswordBox x:Name="PassBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>

            <TextBlock x:Name="ErrText" Foreground="#D9534F" Margin="0,12,0,0"
                       TextWrapping="Wrap" FontSize="12"/>

            <Button x:Name="LoginBtn" Content="登录" Width="100" Height="34"
                    Background="#3D5AFE" Foreground="White" FontWeight="SemiBold"
                    HorizontalAlignment="Right" Margin="0,18,0,0"
                    IsDefault="True" Click="LoginBtn_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
