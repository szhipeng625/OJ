<Window x:Class="author.Presentation.Views.NewProblemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建题目" Height="260" Width="440"
        WindowStartupLocation="CenterOwner" FontSize="13" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="题目标题：" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TitleBox" Grid.Column="1" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="标签：" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TagsBox" Grid.Column="1" VerticalContentAlignment="Center"
                     ToolTip="逗号分隔，如：基础,模拟,字符串"/>
        </Grid>

        <TextBlock Grid.Row="2" Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="题目编号自动生成，标题不能为空。"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="创建" Width="90" IsDefault="True" Click="OnCreate"/>
            <Button Content="取消" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
