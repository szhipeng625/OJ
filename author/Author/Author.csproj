<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>..\..\assets\ACMOJ.ico</ApplicationIcon>
    <RootNamespace>author</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- C++ 出题核心 DLL -->
  <ItemGroup>
    <None Include="..\authorcore\bin\Release\authorcore.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 公共 HandyControl 控件库 + 共享 UI 层（编辑器 / 分页列表 / 只读题面窗口）-->
  <ItemGroup>
    <ProjectReference Include="..\..\shared\HandyControl\HandyControl.csproj" />
    <ProjectReference Include="..\..\shared\OjEditorCore\OjEditorCore.csproj" />
    <ProjectReference Include="..\..\shared\OjUiControls\OjUiControls.csproj" />
    <!-- ACMDOGCodex 核心（Claude 客户端 / 工具集 / 指标） -->
    <ProjectReference Include="..\..\shared\OjCodex\OjCodex.csproj" />
  </ItemGroup>

  <!-- ACMDOGCodex 的 MCP 服务：出题端带 mcp 开关启动时对外暴露题库工具 -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <!-- NuGet 包 -->
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\ACMOJ.png" Link="Assets\ACMOJ.png" />
  </ItemGroup>

</Project>