{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动客户端 client（WPF）",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "构建客户端 (client)",
      "program": "${workspaceFolder}/client/bin/Release/client.dll",
      "args": [],
      "cwd": "${workspaceFolder}/client/bin/Release",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "启动服务端 author（WPF）",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "构建服务端 (author)",
      "program": "${workspaceFolder}/author/Author/bin/Release/Author.dll",
      "args": [],
      "cwd": "${workspaceFolder}/author/Author/bin/Release",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "d:/OJ/author/Author/bin/Debug/problems/125",
      "program": "d:/OJ/author/Author/bin/Debug/problems/125/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}