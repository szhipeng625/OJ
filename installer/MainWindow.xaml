<Window x:Class="OJInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACMOJ下载器" Height="620" Width="580"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/ACMOJ.png"
        Background="#F5F7FA" FontFamily="Microsoft YaHei, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：Logo + 标题 -->
        <Border Grid.Row="0" Background="#294172" Padding="24,24">
            <StackPanel Orientation="Horizontal">
                <Border Width="62" Height="62" CornerRadius="14" Background="White" Margin="0,0,16,0">
                    <Image Source="pack://application:,,,/Assets/ACMOJ.png" Stretch="Uniform" Margin="7"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ACMOJ下载器" Foreground="White" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="ACMDOG 在线判题系统 · 一键安装客户端与出题端" Foreground="#CFE0F7" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 中部：安装配置 + 进度日志 -->
        <StackPanel Grid.Row="1" Margin="24,20">
            <TextBlock Text="安装目录" FontWeight="SemiBold" Foreground="#2B3242" Margin="0,0,0,6"/>
            <DockPanel>
                <Button x:Name="BtnBrowse" Content="浏览..." DockPanel.Dock="Right" Width="78" Height="30"
                        Margin="8,0,0,0" Click="OnBrowse"/>
                <TextBox x:Name="DirBox" Height="30" VerticalContentAlignment="Center" Padding="4,0"/>
            </DockPanel>

            <CheckBox x:Name="ChkDesktop" Content="创建桌面快捷方式" IsChecked="True" Margin="0,16,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,14">
                <Button x:Name="BtnInstall" Content="开始安装" Width="130" Height="36" IsDefault="True"
                        Click="OnInstall" Background="#294172" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand"/>
                <Button x:Name="BtnExit" Content="退出" Width="88" Height="36" Margin="10,0,0,0"
                        IsCancel="True" Click="OnExit" Background="#FFFFFF" Foreground="#294172"
                        BorderBrush="#294172" Cursor="Hand"/>
            </StackPanel>

            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Value="0"
                         Foreground="#294172" Background="#E3E8EF" BorderThickness="0"/>

            <TextBlock Text="安装日志" FontWeight="SemiBold" Foreground="#2B3242" Margin="0,14,0,6"/>
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Height="150" Background="#FBFCFE" BorderBrush="#D7DFEB" AcceptsReturn="True" Padding="6"/>
        </StackPanel>

        <!-- 底部：联系作者 -->
        <Border Grid.Row="2" Padding="24,12" Background="#EEF2F8">
            <TextBlock Text="联系作者：QQ 2014064199" Foreground="#7A8494" FontSize="12" TextAlignment="Center"/>
        </Border>
    </Grid>
</Window>
