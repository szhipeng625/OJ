<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>OJInstaller</RootNamespace>
    <AssemblyName>OJInstaller</AssemblyName>
    <StartupObject>OJInstaller.Program</StartupObject>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\assets\ACMOJ.ico</ApplicationIcon>
    <!-- 自包含单文件：目标机器无需安装 .NET 即可运行安装器 -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 安装包下载地址前缀（以 / 结尾）。打包脚本可用 -p:InstallerBaseUrl=... 覆盖 -->
    <InstallerBaseUrl Condition="'$(InstallerBaseUrl)' == ''">http://YOUR-SERVER/oj/</InstallerBaseUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="InstallerBaseUrl" Value="$(InstallerBaseUrl)" />
    <Resource Include="..\assets\ACMOJ.png" Link="Assets\ACMOJ.png" />
  </ItemGroup>

</Project>
